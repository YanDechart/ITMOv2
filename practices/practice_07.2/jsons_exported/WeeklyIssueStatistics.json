      "id": "b361bdde-631c-42b5-b570-1ec98adee3b1",
      "name": "Every Monday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "function mondayUTC(date) {\n  const d = new Date(Date.UTC(\n    date.getUTCFullYear(),\n    date.getUTCMonth(),\n    date.getUTCDate()\n  ));\n  const day = d.getUTCDay() || 7;\n  d.setUTCDate(d.getUTCDate() - day + 1);\n  return d;\n}\n\nconst now = new Date();\nconst currentMonday = mondayUTC(now);\nconst end = new Date(currentMonday);\n\nif (now.getUTCDay() !== 1) {\n  end.setUTCDate(end.getUTCDate() + 7);\n}\n\nconst start = new Date(end);\nstart.setUTCDate(start.getUTCDate() - 7);\n\nconst previous = new Date(start);\nprevious.setUTCDate(previous.getUTCDate() - 7);\n\nconst dateOnly = d => d.toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    repo: 'YanDechart/ITMOv2',\n    week_start: start.toISOString(),\n    week_end: end.toISOString(),\n    prev_week_start: previous.toISOString(),\n    start_date: dateOnly(start),\n    end_date: dateOnly(end)\n  }\n}];"
      },
