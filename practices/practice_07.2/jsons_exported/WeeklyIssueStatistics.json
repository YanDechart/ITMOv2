    {
      "parameters": {
        "jsCode": "const window = $('Week Window').first().json;\nconst sources = [\n  ['bug', $('Weekly Bugs').first().json.items ?? []],\n  ['task', $('Weekly Tasks').first().json.items ?? []],\n  ['feature', $('Weekly Features').first().json.items ?? []],\n  ['needs_triage', $('Weekly Needs Triage').first().json.items ?? []],\n];\nconst byType = { bug: 0, task: 0, feature: 0, needs_triage: 0 };\nconst byAuthor = {};\nconst issues = [];\nfor (const [type, rows] of sources) {\n  byType[type] = rows.length;\n  for (const issue of rows) {\n    const author = issue.user?.login ?? 'unknown';\n    byAuthor[author] = (byAuthor[author] ?? 0) + 1;\n    issues.push({ number: issue.number, title: issue.title, author, type, url: issue.html_url });\n  }\n}\nconst total = Object.values(byType).reduce((sum, value) => sum + value, 0);\nreturn [{ json: { ...window, total, by_type: byType, by_author: byAuthor, issues } }];"
      },
      "id": "c7860cbc-14ea-4173-ab4e-8db3093e2eca",
      "name": "Group by Type and Author",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "issue_weekly_stats",
          "mode": "name"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "week_start",
              "keyValue": "={{ $json.prev_week_start }}"
            }
          ]
        },
        "limit": 1
      },
      "id": "38099315-3df8-4aae-9424-6e96004205e6",
      "name": "Load Previous Week",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1680,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const current = $('Group by Type and Author').first().json;\nconst prev = $json.week_start ? $json : {};\nconst previous = {\n  total: Number(prev.total) || 0,\n  bug: Number(prev.bug) || 0,\n  task: Number(prev.task) || 0,\n  feature: Number(prev.feature) || 0,\n  needs_triage: Number(prev.needs_triage) || 0\n};\nconst delta = {\n  total: current.total - previous.total,\n  bug: current.by_type.bug - previous.bug,\n  task: current.by_type.task - previous.task,\n  feature: current.by_type.feature - previous.feature,\n  needs_triage: current.by_type.needs_triage - previous.needs_triage\n};\nreturn [{ json: { ...current, previous_exists: Boolean(prev.week_start), previous, delta } }];"
      },
      "id": "a5582064-895f-4850-81d1-337c97797fe8",
      "name": "Calculate Weekly Delta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Подготовь короткий AI-комментарий недели на русском языке для отчёта по GitHub Issues. Не перечисляй таблицу дословно: выдели 2–3 заметных изменения, возможные риски и одно практическое действие. Не выдумывай причин, которых нет в данных.\n\nТекущая статистика:\n{{ JSON.stringify({ total: $json.total, by_type: $json.by_type, by_author: $json.by_author }) }}\n\nПредыдущая неделя:\n{{ JSON.stringify($json.previous) }}\n\nИзменение Δ:\n{{ JSON.stringify($json.delta) }}",
        "batching": {}
      },
      "id": "8da87676-0511-4489-a5fe-4b5b0fe6950c",
      "name": "AI Comment of the Week",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        2160,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "openai/gpt-5.6-sol",
          "mode": "list",
          "cachedResultName": "openai/gpt-5.6-sol"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "82eda8ef-fd4d-4304-b9f9-e86b17f39713",
      "name": "Weekly Report Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        2160,
        224
      ],
      "credentials": {
        "openAiApi": {
          "id": "namiMl0SrQGuVT92",
          "name": "OpenAI account 8"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const stats = $('Calculate Weekly Delta').first().json;\nconst ai = String($json.output ?? $json.text ?? 'Недостаточно данных для AI-комментария.');\nconst esc = value => String(value).replace(/[&<>\"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[ch]));\nconst sign = n => n > 0 ? `+${n}` : String(n);\nconst labels = { bug: 'Bug', task: 'Task', feature: 'Feature', needs_triage: 'Needs triage' };\nconst typeRows = Object.keys(labels).map(key => `<tr><td>${labels[key]}</td><td>${stats.by_type[key]}</td><td>${stats.previous[key]}</td><td>${sign(stats.delta[key])}</td></tr>`).join('');\nconst authorRows = Object.entries(stats.by_author).sort((a,b) => b[1]-a[1]).map(([author,count]) => `<tr><td>${esc(author)}</td><td>${count}</td></tr>`).join('') || '<tr><td colspan=\"2\">Нет Issues</td></tr>';\nconst html = `<!doctype html><html><body style=\"font-family:Arial,sans-serif;color:#222\"><h2>Еженедельная статистика GitHub Issues</h2><p><b>Репозиторий:</b> ${esc(stats.repo)}<br><b>Период:</b> ${stats.week_start.slice(0,10)} — ${stats.week_end.slice(0,10)}</p><h3>По типам</h3><table cellpadding=\"8\" cellspacing=\"0\" border=\"1\" style=\"border-collapse:collapse\"><tr><th>Тип</th><th>Текущая</th><th>Прошлая</th><th>Δ</th></tr>${typeRows}<tr><th>Всего</th><th>${stats.total}</th><th>${stats.previous.total}</th><th>${sign(stats.delta.total)}</th></tr></table><h3>По авторам</h3><table cellpadding=\"8\" cellspacing=\"0\" border=\"1\" style=\"border-collapse:collapse\"><tr><th>Автор</th><th>Issues</th></tr>${authorRows}</table><h3>AI-комментарий недели</h3><div style=\"padding:12px;background:#f3f4f6;border-left:4px solid #6366f1\">${esc(ai)}</div></body></html>`;\nreturn [{ json: { ...stats, ai_comment: ai, html, subject: `GitHub Issues: недельный отчёт ${stats.week_start.slice(0,10)}` } }];"
      },
      "id": "308a2a59-1707-4baa-ab8c-36b63df304e9",
      "name": "Build HTML Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
