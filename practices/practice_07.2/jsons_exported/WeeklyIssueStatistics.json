      "parameters": {
        "jsCode": "const s = $('Build HTML Report').first().json;\nreturn [{ json: {\n  week_start: s.week_start, week_end: s.week_end, repo: s.repo, total: s.total,\n  bug: s.by_type.bug, task: s.by_type.task, feature: s.by_type.feature, needs_triage: s.by_type.needs_triage,\n  by_author: JSON.stringify(s.by_author), ai_comment: s.ai_comment, created_at: new Date().toISOString()\n} }];"
      },
