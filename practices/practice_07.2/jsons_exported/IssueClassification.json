      "name": "Run Issue Classifier",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        480,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const issue = $('Only Newly Opened Issues').first().json;\nconst result = $json.output ?? $json;\nconst allowed = ['bug', 'task', 'feature'];\nconst type = String(result.type ?? 'unknown').toLowerCase();\nconst confidence = Math.max(0, Math.min(1, Number(result.confidence) || 0));\nconst route = confidence >= 0.8 && allowed.includes(type) ? type : 'unknown';\nreturn [{ json: { ...issue, type, confidence, route } }];"
      },
