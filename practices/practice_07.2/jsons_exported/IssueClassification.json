    {
      "parameters": {
        "jsCode": "const p = $json.body ?? $json;\nif (p.action !== 'opened' || !p.issue || p.issue.pull_request) return [];\nconst repo = p.repository?.full_name;\nif (!repo) return [];\nconst [owner, repository] = repo.split('/');\nreturn [{ json: {\n  owner, repository, repo,\n  issue_number: Number(p.issue.number),\n  issue_id: String(p.issue.id ?? `${repo}#${p.issue.number}`),\n  title: String(p.issue.title ?? ''),\n  body: String(p.issue.body ?? ''),\n  author: String(p.issue.user?.login ?? 'unknown'),\n  author_association: String(p.issue.author_association ?? 'NONE')\n} }];"
      },
      "id": "095eb500-7048-47a6-b593-9599a7c982f5",
