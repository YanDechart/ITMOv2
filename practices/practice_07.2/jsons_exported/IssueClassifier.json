      "id": "d1c67657-3ae7-47d0-afaa-0d3263a24056",
      "name": "Classification Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        448,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output ?? $json;\nlet value = raw;\nif (typeof value === 'string') {\n  try { value = JSON.parse(value.replace(/```(?:json)?|```/g, '').trim()); } catch { value = {}; }\n}\nconst allowed = ['bug', 'task', 'feature', 'unknown'];\nconst type = allowed.includes(String(value.type).toLowerCase()) ? String(value.type).toLowerCase() : 'unknown';\nconst confidence = Math.max(0, Math.min(1, Number(value.confidence) || 0));\nreturn [{ json: { type, confidence } }];"
      },
      "id": "fb9e4c4c-5fef-4859-809d-d56e6393c638",
