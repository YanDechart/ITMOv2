    {
      "parameters": {
        "jsCode": "const raw = $json.body ?? $json;\nconst p = (raw && (raw.action || raw.pull_request || raw.comment || raw.issue)) ? raw : $json;\nconst command = String(p.comment?.body ?? '').trim().split(/\\s+/)[0];\nconst isComment = Boolean(p.comment);\nconst isPullRequestEvent = Boolean(p.pull_request) && !isComment;\nconst allowed = ['/make_ai_review', '/make_other_ai_review'];\n\nif (isPullRequestEvent && p.action !== 'opened') return [];\nif (isComment && (p.action !== 'created' || !p.issue?.pull_request || !allowed.includes(command))) return [];\nif (!isPullRequestEvent && !isComment) return [];\n\nconst repoFullName = p.repository?.full_name ?? p.pull_request?.base?.repo?.full_name;\nconst prNumber = p.number ?? p.issue?.number ?? p.pull_request?.number;\nif (!repoFullName || !prNumber) return [];\nconst [owner, repository] = repoFullName.split('/');\nconst effectiveCommand = isComment ? command : '/make_ai_review';\nconst isOther = effectiveCommand === '/make_other_ai_review';\n\nreturn [{ json: {\n  repo_full_name: repoFullName, owner, repository,\n  pr_number: Number(prNumber),\n  pr_key: `${repoFullName}#${prNumber}`,\n  command: effectiveCommand,\n  is_other: isOther,\n  model_label: isOther ? 'openai/gpt-5.6-luna' : 'openai/gpt-5.6-sol',\n  source: isComment ? 'comment' : 'pull_request_opened',\n  github_action: p.action\n} }];"
      },
