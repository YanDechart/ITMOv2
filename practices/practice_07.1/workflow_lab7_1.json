    {
      "parameters": {
        "jsCode": "const hunks = $('Split Diff Into Hunks').all();\nconst answers = $input.all();\nconst meta = $('Normalize Event').first().json;\nconst comments = answers.map((item, i) => {\n  const h = hunks[i]?.json ?? hunks[0]?.json;\n  const answer = String(item.json.output ?? item.json.text ?? '').trim();\n  if (!answer || answer.toUpperCase() === 'SKIP') return null;\n  return {\n    path: h.path,\n    line: Number(h.line),\n    side: h.side,\n    body: `🤖 **${meta.model_label}**\\n\\n${answer}`\n  };\n}).filter(c => c && c.path && c.line);\nreturn comments.length ? [{ json: { ...meta, comments, block_count: comments.length } }] : [];"
      },
