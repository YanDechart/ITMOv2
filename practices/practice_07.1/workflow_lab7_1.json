      "id": "e7734292-d5ee-4c22-a065-9cd7ae5e835c",
      "name": "Get PR Diff",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2144,
        32
      ],
      "typeVersion": 4.2,
      "credentials": {
        "githubApi": {
          "id": "B4mN67cIcHBpmxr1",
          "name": "GitHub account 7"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.data ?? $json.body ?? $json;\nconst diff = typeof raw === 'string' ? raw : JSON.stringify(raw);\nconst lines = diff.split('\\n');\nconst hunks = [];\nlet path = '';\nlet current = null;\n\nfunction flush() {\n  if (!current) return;\n  let oldLine = current.oldStart;\n  let newLine = current.newStart;\n  let rightTarget = null;\n  let leftTarget = null;\n  for (const line of current.lines) {\n    if (line.startsWith('+') && !line.startsWith('+++')) { rightTarget ??= newLine; newLine++; continue; }\n    if (line.startsWith('-') && !line.startsWith('---')) { leftTarget ??= oldLine; oldLine++; continue; }\n    if (!line.startsWith('\\\\')) { oldLine++; newLine++; }\n  }\n  const side = rightTarget !== null ? 'RIGHT' : 'LEFT';\n  const target = rightTarget ?? leftTarget;\n  if (path && target !== null) hunks.push({ path, line: target, side, hunk: [current.header, ...current.lines].join('\\n') });\n  current = null;\n}\n\nfor (const line of lines) {\n  if (line.startsWith('diff --git ')) { flush(); path = ''; continue; }\n  if (line.startsWith('+++ b/')) { path = line.slice(6); continue; }\n  const m = line.match(/^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n  if (m) { flush(); current = { header: line, oldStart: Number(m[1]), newStart: Number(m[2]), lines: [] }; continue; }\n  if (current) current.lines.push(line);\n}\nflush();\n\nif (!hunks.length) return [{ json: { path: 'README.md', line: 1, side: 'RIGHT', hunk: diff.slice(0, 12000), hunk_index: 0 } }];\nreturn hunks.map((h, i) => ({ json: { ...h, hunk_index: i } }));"
      },
      "id": "b64fcbd6-df8b-45ba-a1a2-38466e33bcc1",
      "name": "Split Diff Into Hunks",
