{"type":"text","timestamp":1792954502547,"sessionID":"ses_e8b95ad72ffeaYXBbHPFMY08tu","part":{"id":"prt_1746a843a001a43ibkVza4V23o","sessionID":"ses_e8b95ad72ffeaYXBbHPFMY08tu","messageID":"msg_1746a52ad0017Ou4pl8T5v7cVa","type":"text","text":"{\"tool\":\"refuse\",\"reason\":\"Доступ к инструментам для генерации или возврата чеков заказов ограничен. Для выполнения запроса пользователю необходимо предоставить утотный инструмент receive_file() или export_receipts(), который позволяет сформировать чек по order_id.\"}","time":{"start":1792954500154,"end":1792954502547}}}
