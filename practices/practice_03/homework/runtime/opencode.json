{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": { "context": 65536, "output": 4096 }
        }
      }
    }
  },
  "agent": {
    "hw-local-A": {
      "description": "HW baseline read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./prompts/system_A.txt}",
      "steps": 8,
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow" }
    },
    "hw-local-B": {
      "description": "HW strict repo-grounded read-only assistant",
      "mode": "primary",
      "prompt": "{file:./prompts/system_B.txt}",
      "steps": 8,
      "permission": { "*": "deny", "read": "allow", "glob": "allow", "grep": "allow" }
    }
  }
}
