{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "model": "vsellm/openai/gpt-5",
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "practice4-password": {
        "type": "local",
        "command": ["python3", "practices/practice_04/mcp_server.py"],
        "cwd": "."
      }
    }
  }
}
